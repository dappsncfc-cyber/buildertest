rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: check if the signed-in user has the 'builder' role in /users/{uid}
    function isBuilder() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'builder';
    }

    // User profiles: users can read/write their own profile,
    // but cannot self-escalate to 'builder' once created (edit in Firebase Console for production).
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;

      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Projects collection:
    // Signed-in users can read projects and post updates (variations sign-off, BACS confirmation, chat, docs).
    // For stricter per-client isolation in production, add a `clientUid` field to each project doc
    // and restrict `read`/`update` to `isBuilder() || resource.data.clientUid == request.auth.uid`.
    match /projects/{projectId} {
      allow read, write: if isSignedIn();
    }

    // Notification queue: portal writes events here; Cloud Functions reads/updates via Admin SDK.
    match /notifications/{notificationId} {
      allow read, create: if isSignedIn();
    }
  }
}
