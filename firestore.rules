rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: check if the signed-in user has the 'owner' role (Chris)
    function isOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // Helper: check if the signed-in user has the 'builder' or 'owner' role in /users/{uid}
    function isBuilder() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['builder', 'owner'];
    }

    // User profiles: users can read/write their own profile,
    // while Chris (Owner) can list users and assign client/builder/owner roles.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwner());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner()
        || (isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role);

      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Builder & Client directory profiles: readable by signed-in users, writable ONLY by Chris (Owner).
    match /profiles/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // Projects collection:
    // Signed-in users can read projects and post updates (variations sign-off, BACS confirmation, chat, docs).
    match /projects/{projectId} {
      allow read, write: if isSignedIn();
    }

    // Notification queue: portal writes events here; Cloud Functions reads/updates via Admin SDK.
    match /notifications/{notificationId} {
      allow read, create: if isSignedIn();
    }
  }
}
